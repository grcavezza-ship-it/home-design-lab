<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "tertiary-fixed": "#f5dfc6",
                        "surface-container": "#f0eded",
                        "on-tertiary-fixed": "#251a0a",
                        "inverse-primary": "#87d992",
                        "surface": "#fbf9f8",
                        "primary-container": "#186c32",
                        "surface-bright": "#fbf9f8",
                        "on-tertiary-container": "#ead4bb",
                        "tertiary-fixed-dim": "#d8c3ab",
                        "on-primary-fixed": "#002109",
                        "outline-variant": "#bfc9bc",
                        "on-secondary-fixed-variant": "#005313",
                        "primary": "#005220",
                        "surface-variant": "#e4e2e1",
                        "on-tertiary": "#ffffff",
                        "inverse-surface": "#303030",
                        "surface-dim": "#dcd9d9",
                        "on-secondary-container": "#00731e",
                        "secondary-fixed": "#94f990",
                        "background": "#fbf9f8",
                        "on-tertiary-fixed-variant": "#534432",
                        "on-surface-variant": "#40493f",
                        "on-secondary-fixed": "#002204",
                        "surface-tint": "#196c32",
                        "surface-container-low": "#f6f3f2",
                        "on-primary": "#ffffff",
                        "tertiary": "#524431",
                        "primary-fixed-dim": "#87d992",
                        "on-primary-fixed-variant": "#005321",
                        "on-error": "#ffffff",
                        "secondary": "#006e1c",
                        "on-surface": "#1b1c1c",
                        "surface-container-high": "#eae8e7",
                        "inverse-on-surface": "#f3f0f0",
                        "secondary-container": "#91f78e",
                        "on-secondary": "#ffffff",
                        "error-container": "#ffdad6",
                        "secondary-fixed-dim": "#78dc77",
                        "surface-container-highest": "#e4e2e1",
                        "primary-fixed": "#a3f5ac",
                        "on-background": "#1b1c1c",
                        "outline": "#707a6e",
                        "error": "#ba1a1a",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#6b5b47",
                        "on-primary-container": "#98eba2",
                        "surface-container-lowest": "#ffffff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "fontFamily": {
                        "headline": ["Noto Serif"],
                        "body": ["Manrope"],
                        "label": ["Manrope"]
                    }
                },
            },
        }
    </script>
    <script>
        // Stato globale per editing
        let isEditMode = false;
        let currentEditingId = null;
        let originalValues = {};

        // Carica clienti dal database
        async function loadClienti() {
            try {
                const { data: clienti, error } = await supabase
                    .from('clienti_profiles')
                    .select('*')
                    .order('name', { ascending: true });

                if (error) throw error;

                renderClienti(clienti || []);

            } catch (err) {
                console.error('Errore caricamento clienti:', err);
                showError('Errore nel caricamento dei clienti');
            }
        }

        // Renderizza clienti nella tabella
        async function renderClienti(clienti) {
            const tbody = document.getElementById('clienti-tbody');
            const emptyState = document.getElementById('empty-state');

            if (!clienti || clienti.length === 0) {
                tbody.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            
            let html = '';
            for (const cliente of clienti) {
                // Conta progetti associati
                const { data: progetti, error: progettiError } = await supabase
                    .from('projects')
                    .select('id')
                    .eq('cliente_id', cliente.id);

                const numProgetti = progettiError ? 0 : (progetti?.length || 0);

                html += `
                    <tr data-client-id="${cliente.id}" class="hover:bg-surface-container-low/50 transition-colors cursor-pointer" onclick="showDetail('${cliente.id}')">
                        <td class="px-6 py-4">
                            <div class="ragione-sociale font-medium text-on-surface">${cliente.name || '-'}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="email text-sm text-on-surface-variant">${cliente.email || '-'}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="telefono text-sm text-on-surface-variant">${cliente.phone || '-'}</div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center gap-1 px-2 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">
                                <span class="material-symbols-outlined text-[12px]">architecture</span>
                                ${numProgetti} progetti
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <button onclick="event.stopPropagation(); deleteClient('${cliente.id}')" class="text-slate-600 hover:text-slate-800 transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }

            tbody.innerHTML = html;
        }

        // Mostra dettaglio cliente
        async function showDetail(clientId) {
            try {
                const { data: cliente, error } = await supabase
                    .from('clienti_profiles')
                    .select('*')
                    .eq('id', clientId)
                    .single();

                if (error) throw error;

                // Carica progetti associati
                const { data: progetti, error: progettiError } = await supabase
                    .from('projects')
                    .select('id, titolo, status')
                    .eq('cliente_id', clientId)
                    .order('created_at', { ascending: false });

                renderDetailPanel(cliente, progetti || []);

            } catch (err) {
                console.error('Errore caricamento dettaglio cliente:', err);
                showError('Errore nel caricamento dei dettagli');
            }
        }

        // Renderizza pannello dettaglio
        function renderDetailPanel(cliente, progetti) {
            const detailPanel = document.getElementById('detail-panel');
            
            detailPanel.innerHTML = `
                <div class="space-y-6">
                    <div class="flex justify-between items-start">
                        <div>
                            <h2 class="text-xl font-headline font-bold text-on-surface mb-1">${cliente.name}</h2>
                            <p class="text-sm text-on-surface-variant">Cliente</p>
                        </div>
                        <button id="edit-client-btn" onclick="toggleClientEdit('${cliente.id}')" class="px-3 py-1.5 bg-slate-700 text-white rounded-lg text-xs font-bold uppercase hover:bg-slate-800 transition-colors flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">edit</span>
                            Modifica
                        </button>
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary">mail</span>
                            <div class="client-email text-sm text-on-surface">${cliente.email || '-'}</div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary">phone</span>
                            <div class="client-phone text-sm text-on-surface">${cliente.phone || '-'}</div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-primary">location_on</span>
                            <div class="client-address text-sm text-on-surface">${cliente.address || '-'}</div>
                        </div>
                        <div class="pt-2">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-outline">Note</span>
                            <div class="client-note text-sm text-on-surface mt-1">${cliente.notes || '-'}</div>
                        </div>
                    </div>

                    ${progetti.length > 0 ? `
                        <div class="border-t border-outline-variant/20 pt-4">
                            <h3 class="text-sm font-bold uppercase tracking-widest text-outline mb-3">Progetti Associati</h3>
                            <div class="space-y-2">
                                ${progetti.map(progetto => `
                                    <div class="flex items-center justify-between p-2 bg-surface-container-low rounded-lg hover:bg-surface-container transition-colors">
                                        <a href="dettaglio-progetto.html?id=${progetto.id}" class="text-sm font-medium text-primary hover:text-primary/80">
                                            ${progetto.titolo}
                                        </a>
                                        <span class="text-xs px-2 py-1 bg-primary/10 text-primary rounded-full">
                                            ${progetto.status}
                                        </span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    ` : ''}
                </div>
            `;
        }

        // Toggle editing cliente
        function toggleClientEdit(clientId) {
            if (isEditMode) {
                saveClientEdit();
            } else {
                startClientEdit(clientId);
            }
        }

        // Inizia editing cliente
        function startClientEdit(clientId) {
            const elements = ['client-email', 'client-phone', 'client-address', 'client-note'];
            
            elements.forEach(elId => {
                const element = document.querySelector(`.${elId}`);
                if (element) {
                    originalValues[elId] = element.textContent.trim();
                    const currentValue = originalValues[elId];
                    element.innerHTML = `<input type="text" class="w-full px-2 py-1 border border-cyan-300 rounded focus:outline-none focus:ring-2 focus:ring-cyan-500 bg-cyan-50 text-sm" value="${currentValue}" />`;
                    element.classList.add('ring-2', 'ring-cyan-500', 'bg-cyan-50');
                }
            });

            currentEditingId = clientId;
            isEditMode = true;
            
            const editBtn = document.getElementById('edit-client-btn');
            editBtn.innerHTML = '<span class="material-symbols-outlined text-[14px]">save</span> Salva';
            editBtn.className = 'px-3 py-1.5 bg-emerald-500 text-white rounded-lg text-xs font-bold uppercase hover:bg-emerald-600 transition-colors flex items-center gap-1';
        }

        // Salva editing cliente
        async function saveClientEdit() {
            try {
                const updateData = {
                    email: document.querySelector('.client-email input')?.value,
                    phone: document.querySelector('.client-phone input')?.value,
                    address: document.querySelector('.client-address input')?.value,
                    notes: document.querySelector('.client-note input')?.value
                };

                const { error } = await supabase
                    .from('clienti_profiles')
                    .update(updateData)
                    .eq('id', currentEditingId);

                if (error) throw error;

                showNotification('Cliente aggiornato con successo!');
                showDetail(currentEditingId); // Ricarica dettaglio
                loadClienti(); // Aggiorna lista
                isEditMode = false;
                currentEditingId = null;

            } catch (err) {
                console.error('Errore salvataggio cliente:', err);
                showNotification('Errore nel salvataggio');
            }
        }

        // Mostra form nuovo cliente
        function showAddClientForm() {
            const detailPanel = document.getElementById('detail-panel');
            
            detailPanel.innerHTML = `
                <div class="space-y-6">
                    <h2 class="text-xl font-headline font-bold text-on-surface mb-4">Nuovo Cliente</h2>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-on-surface mb-1">Nome/Ragione Sociale</label>
                            <input type="text" id="new-client-name" class="w-full px-3 py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm" placeholder="Inserisci nome..." />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface mb-1">Email</label>
                            <input type="email" id="new-client-email" class="w-full px-3 py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm" placeholder="email@esempio.com" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface mb-1">Telefono</label>
                            <input type="tel" id="new-client-phone" class="w-full px-3 py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm" placeholder="+39 012 345678" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface mb-1">Indirizzo</label>
                            <input type="text" id="new-client-address" class="w-full px-3 py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm" placeholder="Via Roma, 123" />
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button onclick="saveNewClient()" class="flex-1 bg-primary text-white rounded-lg py-2.5 text-sm font-bold hover:opacity-90 transition-opacity">
                            Salva Cliente
                        </button>
                        <button onclick="showDetail(null)" class="flex-1 bg-slate-700 text-white rounded-lg py-2.5 text-sm font-bold hover:bg-slate-800 transition-colors">
                            Annulla
                        </button>
                    </div>
                </div>
            `;
        }

        // Salva nuovo cliente
        async function saveNewClient() {
            try {
                const clientData = {
                    name: document.getElementById('new-client-name').value,
                    email: document.getElementById('new-client-email').value,
                    phone: document.getElementById('new-client-phone').value,
                    address: document.getElementById('new-client-address').value,
                    notes: ''
                };

                if (!clientData.name) {
                    showNotification('Il nome è obbligatorio');
                    return;
                }

                const { data, error } = await supabase
                    .from('clienti_profiles')
                    .insert([clientData])
                    .select();

                if (error) throw error;

                showNotification('Cliente creato con successo!');
                showDetail(null); // Pulisci pannello
                loadClienti(); // Aggiorna lista

            } catch (err) {
                console.error('Errore creazione cliente:', err);
                showNotification('Errore nella creazione del cliente');
            }
        }

        // Elimina cliente
        async function deleteClient(clientId) {
            if (!confirm('Sei sicuro di voler eliminare questo cliente?')) return;

            try {
                const { error } = await supabase
                    .from('clienti_profiles')
                    .delete()
                    .eq('id', clientId);

                if (error) throw error;

                showNotification('Cliente eliminato con successo!');
                loadClienti(); // Aggiorna lista
                showDetail(null); // Pulisci pannello

            } catch (err) {
                console.error('Errore eliminazione cliente:', err);
                showNotification('Errore nell\'eliminazione del cliente');
            }
        }

        // Mostra notifica
        function showNotification(message) {
            const notif = document.createElement('div');
            notif.className = 'fixed bottom-4 right-4 bg-primary text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in';
            notif.innerHTML = `<span class="material-symbols-outlined align-middle mr-2">check_circle</span>${message}`;
            document.body.appendChild(notif);
            setTimeout(() => notif.remove(), 3000);
        }

        // Carica clienti al caricamento pagina
        document.addEventListener('DOMContentLoaded', loadClienti);
    </script>
<style>
        body { font-family: 'Manrope', sans-serif; }
        .font-headline { font-family: 'Noto Serif', serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .surface-shift-no-lines { border: none !important; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #eae8e7; border-radius: 10px; }
    </style>
</head>
