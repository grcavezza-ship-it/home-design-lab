<nav id="sidebar-menu" class="bg-[#f6f3f2] dark:bg-stone-900 text-[#186C32] dark:text-[#4ade80] font-['Manrope'] font-medium uppercase tracking-widest text-[10px] h-screen w-64 fixed left-0 top-0 border-r-0 flex flex-col py-8 z-50">
<div class="px-8 mb-12">
<h1 class="font-['Noto_Serif'] text-2xl font-bold tracking-tighter text-[#186C32] dark:text-[#4ade80]">Atelier Studio</h1>
<p class="text-stone-500 mt-1 capitalize tracking-normal text-xs">Gestione Clienti</p>
</div>
<div class="flex-1 space-y-2">
<a class="text-stone-500 dark:text-stone-400 hover:text-[#186C32] dark:hover:text-[#4ade80] px-8 py-3 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800/50 flex items-center gap-4" href="dashboard-senior.html">
<span class="material-symbols-outlined">dashboard</span>
                Dashboard
            </a>
<a class="text-stone-500 dark:text-stone-400 hover:text-[#186C32] dark:hover:text-[#4ade80] px-8 py-3 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800/50 flex items-center gap-4" href="gestione-progetti.html">
<span class="material-symbols-outlined">architecture</span>
                Progetti
            </a>
<a class="text-stone-500 dark:text-stone-400 hover:text-[#186C32] dark:hover:text-[#4ade80] px-8 py-3 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800/50 flex items-center gap-4" href="gestione-immobili.html">
<span class="material-symbols-outlined">inventory_2</span>
                Immobili
            </a>
<a class="text-stone-500 dark:text-stone-400 hover:text-[#186C32] dark:hover:text-[#4ade80] px-8 py-3 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800/50 flex items-center gap-4" href="gestione-journal.html">
<span class="material-symbols-outlined">menu_book</span>
                Journal
            </a>
<a class="text-stone-500 dark:text-stone-400 hover:text-[#186C32] dark:hover:text-[#4ade80] px-8 py-3 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800/50 flex items-center gap-4" href="gestione-team.html">
<span class="material-symbols-outlined">groups</span>
                Team
            </a>
<a class="text-[#186C32] dark:text-[#4ade80] font-bold bg-[#ffffff] dark:bg-stone-800 rounded-l-xl ml-4 pl-4 py-3 transition-all border-r-4 border-[#186C32] transition-all duration-300 flex items-center gap-4" href="gestione-clienti.html">
<span class="material-symbols-outlined">handshake</span>
                Clienti
            </a>
</div>
<div class="px-8 mt-auto mb-8">
<button class="w-full bg-gradient-to-br from-primary to-primary-container text-on-primary rounded-md py-3 text-xs font-bold tracking-widest uppercase hover:opacity-90 transition-opacity">
                Nuovo Progetto
            </button>
</div>
<div class="space-y-2 border-t border-stone-200 dark:border-stone-800 pt-4">
<a class="text-stone-500 dark:text-stone-400 hover:text-[#186C32] dark:hover:text-[#4ade80] px-8 py-2 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800/50 flex items-center gap-4" href="#">
<span class="material-symbols-outlined text-[18px]">add_to_drive</span>
                Google Drive
            </a>
<a class="text-stone-500 dark:text-stone-400 hover:text-[#186C32] dark:hover:text-[#4ade80] px-8 py-2 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800/50 flex items-center gap-4" href="#">
<span class="material-symbols-outlined text-[18px]">settings</span>
                Impostazioni
            </a>
</div>
</nav>
<!-- TopAppBar Master Shell -->
<header class="bg-[#fbf9f8]/80 dark:bg-stone-950/80 backdrop-blur-xl text-[#186C32] dark:text-[#4ade80] font-['Noto_Serif'] italic text-lg fixed top-0 right-0 w-[calc(100%-16rem)] z-40 border-b border-stone-200/30 dark:border-stone-800/30 flex justify-between items-center px-10 h-20 transition-all">
<div class="flex-1 flex items-center h-full">
<span class="leading-none">Studio Management</span>
</div>
<div class="flex items-center gap-6 h-full">
<div class="relative w-64 flex items-center">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm pointer-events-none">search</span>
<input class="w-full bg-surface-variant/50 border-none rounded-full py-2 pl-10 pr-4 text-sm font-body not-italic text-on-surface focus:ring-1 focus:ring-primary outline-none placeholder:text-stone-400" placeholder="Search resources..." type="text"/>
</div>
<button class="text-stone-400 hover:opacity-70 transition-opacity flex items-center justify-center h-10 w-10"><span class="material-symbols-outlined">notifications</span></button>
<button class="text-stone-400 hover:opacity-70 transition-opacity flex items-center justify-center h-10 w-10"><span class="material-symbols-outlined">history</span></button>
<button class="text-stone-400 hover:opacity-70 transition-opacity flex items-center justify-center h-10 w-10"><span class="material-symbols-outlined">account_tree</span></button>
<!-- Avatar Dropdown -->
<div class="relative" id="avatar-dropdown-container">
<button id="avatar-btn" class="flex items-center justify-center w-10 h-10 rounded-full overflow-hidden border border-stone-200 hover:border-primary transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50">
<img id="avatar-img" alt="User Avatar" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCwG2p67wXSg3yZM4v78cF44Jy6CevBMWdFF0Iz5N8ieMyH5aHUo-pzkZEUmp41WOLHPgXsQ7imCCLFj9R4ko2bUAUS4Sn0Td3fDI_UvP1-CfZcCw8Iu1b9rgxPHntL2Yx8nX4U9OV58lvBS91QSW8Kx5WWS0o_Biygd98KH8GqOPWwFa-zlQpnWUvVJVPcGQX0jAuL3_Y-DRMUSVRfevyEJumLQi1NusaNR6sgjpub3Vmt_cxFcZBUd5fAaAEftjRTCvpHWHkBTRA"/>
</button>
<!-- Dropdown Menu -->
<div id="avatar-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-stone-900 rounded-lg shadow-lg border border-stone-200 dark:border-stone-700 py-1 z-50">
<a href="#" class="flex items-center gap-3 px-4 py-2.5 text-sm text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors">
<span class="material-symbols-outlined text-[18px]">person</span>👤 Profilo</a>
<a href="#" class="flex items-center gap-3 px-4 py-2.5 text-sm text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors">
<span class="material-symbols-outlined text-[18px]">settings</span>⚙️ Impostazioni</a>
<div class="border-t border-stone-200 dark:border-stone-700 my-1"></div>
<a href="#" id="dropdown-logout" class="flex items-center gap-3 px-4 py-2.5 text-sm text-error hover:bg-error-container/10 transition-colors">
<span class="material-symbols-outlined text-[18px]">logout</span>🚪 Esci</a>
</div>
</div>
</div>
</header>

<main class="ml-64 pt-28 px-12 pb-24 bg-surface min-h-screen">
<header class="flex justify-between items-end mb-12">
<div>
<span class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary block mb-2">Management Console</span>
<h1 class="text-4xl font-headline font-bold text-on-surface tracking-tight">Customer Relations</h1>
</div>
<div class="flex items-center gap-6">
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-lg">search</span>
<input class="pl-10 pr-4 py-2.5 bg-surface-container-low border-none rounded-lg text-sm w-72 focus:ring-1 focus:ring-primary" placeholder="Filter by name or project..." type="text"/>
</div>
</div>
</header>
<div class="grid grid-cols-12 gap-8">
<div class="col-span-8 space-y-8">
